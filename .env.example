# ============================================
# AI Idea Bench 2025 Configuration Template
# ============================================
# Copy this file to `.env` and fill in your values
# DO NOT commit `.env` to version control!
#
# This project uses OpenAI-compatible API format.
# You can use any provider that supports this format:
# - OpenAI (api.openai.com)
# - DeepSeek (api.deepseek.com)
# - Azure OpenAI
# - Local LLMs (vLLM, Ollama, LM Studio, etc.)
# - Any OpenAI-compatible endpoint
# ============================================

# ===================
# LLM API Configuration (OpenAI-compatible)
# ===================

# Primary LLM - Used for idea generation (AI-Scientist)
# Examples:
#   OpenAI:   IDEA_GEN_API_KEY=sk-xxx, IDEA_GEN_BASE_URL=https://api.openai.com/v1, IDEA_GEN_MODEL_NAME=gpt-4o
#   DeepSeek: IDEA_GEN_API_KEY=sk-xxx, IDEA_GEN_BASE_URL=https://api.deepseek.com/v1, IDEA_GEN_MODEL_NAME=deepseek-chat
#   Local:    IDEA_GEN_API_KEY=not-needed, IDEA_GEN_BASE_URL=http://localhost:8000/v1, IDEA_GEN_MODEL_NAME=Qwen2.5-72B
IDEA_GEN_API_KEY=your_api_key_here
IDEA_GEN_BASE_URL=https://api.openai.com/v1
IDEA_GEN_MODEL_NAME=gpt-4o

# Evaluation LLM - Used for MCQ, competition, idea matching, novelty assessment
# Can be the same as primary LLM or a different (cheaper) model
EVAL_API_KEY=your_api_key_here
EVAL_BASE_URL=https://api.deepseek.com/v1
EVAL_MODEL_NAME=deepseek-chat

# Semantic Scholar API Configuration
# Used for paper search and novelty/feasibility assessment
# Get your API key from: https://www.semanticscholar.org/product/api
S2_API_KEY=your_semantic_scholar_api_key_here

# ===================
# Data Paths
# ===================

# Main dataset paths (relative to project root)
PAPERS_DATA_PATH=../papers_data
TARGET_PAPER_DATA_PATH=../target_paper_data.json

# Intermediate data paths
DATASET_TEMPLE_PATH=./dataset_temple
CITED_PAPER_CONTENT_PATH=./dataset_temple/cited_paper_conten.json
MCQ_MOTIVATION_PATH=./dataset_temple/mcq_motivation.json
MCQ_EXPERIMENT_PLAN_PATH=./dataset_temple/mcq_experiment_plan.json
TARGET_PAPER_DATA_W_HD_CD_PATH=./dataset_temple/target_paper_data_w_hd_cd.json
HD_CD_PAPER_CONTENT_PATH=./dataset_temple/hd_cd_paper_conten.json
PAPER_TEMPLE_PATH=./dataset_temple/paper_temple

# Model output paths
MODEL_OUTPUT_BASE_PATH=./model_output

# ===================
# Model Parameters
# ===================

# Idea generation parameters
NUM_REFLECTIONS=3
NUM_IDEAS=2
MAX_NUM_GENERATIONS=20
TEMPERATURE=0.6

# ===================
# External Tools
# ===================

# Java configuration (for Grobid PDF parsing)
# Example: /path/to/jdk-11.0.2
JAVA_HOME=

# Grobid path (optional, if not using default)
GROBID_PATH=

